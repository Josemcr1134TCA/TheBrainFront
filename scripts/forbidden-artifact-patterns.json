  "contents": [
    { "id": "private-key-block", "kind": "regex", "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----", "reason": "llave privada" },
    { "id": "service-role-jwt", "kind": "jwt-role", "role": "service_role", "reason": "llave service_role de Supabase" },
    { "id": "supabase-secret-key", "kind": "regex", "pattern": "\\bsb_secret_[A-Za-z0-9_-]{20,}", "reason": "llave secreta de Supabase" },
    { "id": "supabase-service-role-env", "kind": "regex", "pattern": "\\bSUPABASE_SERVICE_ROLE(?:_KEY)?\\b", "reason": "variable de la llave service_role de Supabase" },
    { "id": "vercel-token-env", "kind": "regex", "pattern": "\\bVERCEL_(?:TOKEN|OIDC_TOKEN)\\b", "reason": "variable de token de Vercel" },
    { "id": "postgres-url-with-password", "kind": "regex", "pattern": "postgres(?:ql)?://[^\\s:@/'\"`]+:[^\\s@/'\"`]+@", "reason": "cadena de conexión a PostgreSQL con contraseña" },
    { "id": "github-token", "kind": "regex", "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{60,})\\b", "reason": "token de GitHub" },
    { "id": "aws-access-key-id", "kind": "regex", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "reason": "llave de acceso de AWS" },
    { "id": "stripe-secret-key", "kind": "regex", "pattern": "\\b[sr]k_(?:live|test)_[0-9A-Za-z]{20,}\\b", "reason": "llave secreta de Stripe" },
    { "id": "slack-token", "kind": "regex", "pattern": "\\bxox[abposr]-[0-9A-Za-z-]{10,}", "reason": "token de Slack" },
    { "id": "google-api-key", "kind": "regex", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "reason": "llave de API de Google o Firebase" }
  ],
  "exceptions": []
}
